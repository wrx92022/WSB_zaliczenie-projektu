<mvc:View controllerName="project1.controller.Detail"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">
    
    <VBox class="sapUiSmallMargin">
        <Button 
            text="Back"
            press="onBackPress"
            icon="sap-icon://nav-back"
            type="Transparent"
            class="sapUiSmallMarginTop" />
        
        <Button 
            text="Edit"
            press="onEditPress"
            visible="true"
            type="Emphasized"
            class="sapUiSmallMarginTop" />
        
        <Panel headerText="{i18n>carDetails}" class="sapUiSmallMarginTop" expandable="false">
            <HBox>
                <Avatar class="sapUiSmallMarginEnd" initials="IS" />
                
                <VBox class="sapUiMediumMarginEnd">
                    <!-- Marka samochodu -->
                    <Text text="Marka: " />
                    <Input value="{carModel>/Marka}" editable="{=${editModel>/editMode} }"/>

                    <!-- Model samochodu -->
                    <Text text="Model: " />
                    <Input value="{carModel>/Model}" editable="{=${editModel>/editMode} }"/>

                    <!-- Rok produkcji samochodu -->
                    <Text text="Rok produkcji: " />
                    <Input value="{carModel>/Rok}" editable="{=${editModel>/editMode} }"/>

                </VBox>
                
                <VBox class="sapUiMediumMarginEnd">
                    <!-- Numer VIN samochodu -->
                    <Text text="Numer VIN: " />
                    <Input value="{carModel>/VIN}" editable="{=${editModel>/editMode} }"/>

                    <!-- Rok produkcji samochodu -->
                    <Text text="Numer rejestracyjny: " />
                    <Input value="{carModel>/RegistrationNumber}" editable="{=${editModel>/editMode} }"/>

                    <!-- Przebieg samochodu -->
                    <Text text="Przebieg: " />
                    <Input value="{carModel>/Mileage}" type="Tel" editable="{=${editModel>/editMode} }"/>

                    <!-- Rodzaj paliwa -->
                    <Text text="Rodzaj paliwa: " />
                    <Input value="{carModel>/FuelType}" type="Email" editable="{=${editModel>/editMode} }"/>

                    <!-- Przypisany właściciel -->
                    <Text text="Przypisany do: " />
                    <Input value="{carModel>/AssignedTo}" type="Tel" editable="{=${editModel>/editMode} }"/>
                </VBox>

                <VBox class="sapUiMediumMarginEnd">
                    <!-- Numer VIN samochodu -->
                    <Text text="Przegląd ważny od: " />
                    <Input value="{carModel>/LastInspection}" editable="{=${editModel>/editMode} }"/>

                    <!-- Rok produkcji samochodu -->
                    <Text text="Następny przegląd: " />
                    <Input value="{carModel>/NextInspection}" editable="{=${editModel>/editMode} }"/>

                    <!-- Przebieg samochodu -->
                    <Text text="Status samochodu: " />
                    <Input value="{carModel>/Status}" type="Tel" editable="{=${editModel>/editMode} }"/>
                </VBox>
                
            </HBox>
        </Panel>

        <Panel headerText="Opis samochodu" class="sapUiSmallMarginTop" expandable="false">
            <Input value="{carModel>/Description}" editable="{=${editModel>/editMode} }"/>
        </Panel>

        <!-- Przycisk Save oraz Cancel w trybie edycji -->
        <HBox visible="{${editModel>/editMode}}">
            <Button text="Save" press="onSavePress"/>
            <Button text="Cancel" press="onCancelPress"/>
        </HBox>
    </VBox>
    
</mvc:View>
