<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:l="sap.ui.layout" xmlns:smartForm="sap.ui.comp.smartform" xmlns:smartField="sap.ui.comp.smartfield">
    <Dialog title="Add Car" class="sapUiResponsivePadding" contentWidth="25rem">
        <content>
            <VBox class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiSmallMarginTop sapUiSmallMarginBottom">
                <Label text="Marka" required="true" />
                <Input id="MarkaInput" />

                <Label text="Model" required="true" />
                <Input id="ModelInput"/>

                <Label text="Rok produkcji" required="true"/>
                <Input id="RokInput"/>

                <Label text="Numer VIN" required="true"/>
                <Input id="VINInput"/>

                <Label text="Numer rejestracyjny" required="true"/>
                <Input id="NumerInput"/>

                <Label text="Przebieg" required="true"/>
                <Input id="PrzebiegInput"/>

                <Label text="Rodzaj paliwa" required="true"/>
                <Input id="PaliwoInput"/>

                <Label text="Przypisany do" required="true"/>
                <Input id="OsobaInput"/>

            </VBox>
        </content>
        <buttons>
            <Button text="Save" type="Emphasized" press="onSaveCar"/>
            <Button text="Cancel" press="onCancelCar"/>
        </buttons>
    </Dialog>
</core:FragmentDefinition>