<mvc:View controllerName="project1.controller.View1"
    xmlns="sap.m"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:table="sap.ui.table"
    xmlns:fb="sap.ui.comp.filterbar">
    <Page id="page" title="{i18n>title}">
        <VBox>
            <fb:FilterBar id="filterbar" persistencyKey="carFilterKey" useToolbar="false" filterChange="onFilterChange">
                <fb:filterGroupItems>
                    <fb:FilterGroupItem name="Marka" label="Marka" groupName="Group1" visibleInFilterBar="true">
                        <fb:control>
                            <Input id="idMarkaInput" liveChange="onFilterChange" />
                        </fb:control>
                    </fb:FilterGroupItem>
                    <fb:FilterGroupItem name="Model" label="Model" groupName="Group1" visibleInFilterBar="true">
                        <fb:control>
                            <Input id="idModelInput" liveChange="onFilterChange" />
                        </fb:control>
                    </fb:FilterGroupItem>
                    <fb:FilterGroupItem name="Rok" label="Rok produkcji" groupName="Group1" visibleInFilterBar="true">
                        <fb:control>
                            <Input id="idRokInput" liveChange="onFilterChange" />
                        </fb:control>
                    </fb:FilterGroupItem>
                </fb:filterGroupItems>
            </fb:FilterBar>
            <Table id="table" items="{path:'Cars>/Cars', sorter: {path: 'Marka'}}" mode="SingleSelectLeft"  itemPress="onCarPress" selectionChange="onItemSelected">
                <headerToolbar>
                    <OverflowToolbar id="otbSubheader">
                        <ToolbarSpacer/>
                        <Button icon="sap-icon://add" text="Add Car" tooltip="Add Car" press="onAddCar" />
                        <Button id="removeCarBtn" icon="sap-icon://delete" text="Remove Car" tooltip="Remove Car" press="onDeleteCar" enabled="false" />
                    </OverflowToolbar>
                </headerToolbar>
                <columns>
                    <Column>
                        <Text text="{i18n>markaColumnTxt}" />
                    </Column>
                    <Column>
                        <Text text="{i18n>modelColumnTxt}" />
                    </Column>
                    <Column>
                        <Text text="{i18n>rokColumnTxt}" />
                    </Column>
                </columns>
                <items>
                    <ColumnListItem type="Navigation">
                        <cells>
                            <Text text="{Cars>Marka}" />
                            <Text text="{Cars>Model}" />
                            <Text text="{Cars>Rok}" />
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </VBox>
    </Page>
</mvc:View>
